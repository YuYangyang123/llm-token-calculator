page {
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  background: #f1f5f9;
  color: #1e293b;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ===== 通用卡片 ===== */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 24rpx;
}

/* ===== 大号输入框 ===== */
.big-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.big-input-prefix {
  font-size: 40rpx;
  font-weight: 700;
  color: #64748b;
}

.big-input {
  flex: 1;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
}

.big-input-unit {
  font-size: 28rpx;
  color: #64748b;
}

/* ===== 快捷按钮 ===== */
.quick-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.quick-btn {
  padding: 10rpx 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 32rpx;
  background: #fff;
  font-size: 24rpx;
  color: #1e293b;
}

.quick-btn.active {
  background: #6366f1;
  color: #fff;
  border-color: #6366f1;
}

/* ===== 结果卡片 ===== */
.result-card {
  border-left: 6rpx solid #6366f1;
}

.big-result {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 0;
}

.result-symbol {
  font-size: 32rpx;
  font-weight: 600;
  color: #6366f1;
}

.result-number {
  font-size: 56rpx;
  font-weight: 800;
  color: #4f46e5;
}

.result-unit {
  font-size: 28rpx;
  color: #64748b;
}

/* ===== 对话等级 ===== */
.level-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.level-btn {
  width: calc(33.33% - 8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 8rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #fff;
  font-size: 24rpx;
  box-sizing: border-box;
}

.level-btn.selected {
  border-width: 3rpx;
}

.level-icon {
  font-size: 40rpx;
}

.level-name {
  font-weight: 700;
  font-size: 26rpx;
}

.level-tokens {
  font-size: 22rpx;
  color: #64748b;
}

/* ===== 对话行 ===== */
.conv-row {
  padding: 14rpx 0;
}

.conv-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.conv-icon { font-size: 30rpx; }
.conv-name { font-weight: 600; font-size: 26rpx; }
.conv-per { font-size: 22rpx; color: #64748b; margin-left: auto; }

.conv-bar-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.conv-bar-bg {
  flex: 1;
  height: 12rpx;
  background: #f1f5f9;
  border-radius: 6rpx;
  overflow: hidden;
}

.conv-bar-fill {
  height: 100%;
  border-radius: 6rpx;
}

.conv-count {
  font-size: 26rpx;
  white-space: nowrap;
}

.conv-count strong { font-size: 32rpx; }

/* ===== 货币切换 ===== */
.currency-wrap {
  display: flex;
  gap: 12rpx;
  margin: 20rpx;
}

.currency-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #fff;
  font-size: 26rpx;
}

.currency-btn.active {
  border-color: #6366f1;
  background: #eef2ff;
}

.currency-symbol { font-weight: 700; color: #6366f1; }

/* ===== 底部备注 ===== */
.note {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  padding: 20rpx;
}

/* ===== 模型选择器 ===== */
.picker-wrap {
  margin: 20rpx;
}

.picker-btn {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  border: 2rpx solid #e2e8f0;
}

.picker-arrow {
  color: #94a3b8;
}

/* ===== 模型信息条 ===== */
.model-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 28rpx;
  background: #eef2ff;
  margin: 0 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.badge-provider {
  background: #6366f1;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-name { font-weight: 700; }
.badge-price { font-size: 22rpx; color: #64748b; margin-left: auto; }

/* ===== 首页按钮 ===== */
.entry-btns {
  margin: 0 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.entry-btn {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.entry-icon { font-size: 48rpx; }
.entry-title { font-size: 32rpx; font-weight: 700; }
.entry-desc { font-size: 24rpx; color: #64748b; display: block; }

/* ===== 文本域 ===== */
.dialog-textarea {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  min-height: 200rpx;
  box-sizing: border-box;
}

/* ===== 统计 ===== */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.stat-item {
  flex: 1;
  min-width: 200rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.stat-item.highlight {
  background: #eef2ff;
}

.stat-item.cost {
  background: #fef3c7;
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 700;
}

/* ===== 模型价格表 ===== */
.price-table {
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #e2e8f0;
}

.price-header {
  display: flex;
  padding: 14rpx 20rpx;
  background: #f8fafc;
  font-size: 24rpx;
  font-weight: 600;
  color: #64748b;
}

.price-row {
  display: flex;
  padding: 12rpx 20rpx;
  border-top: 1rpx solid #e2e8f0;
  font-size: 24rpx;
}

.price-row.current {
  background: #eef2ff;
}

.price-col1 { flex: 2; }
.price-col2 { flex: 1; text-align: right; color: #1d4ed8; }
.price-col3 { flex: 1; text-align: right; color: #15803d; }
